\f0\fs24 \cf0 <!DOCTYPE html>\
<html lang="en">\
<head>\
  <meta charset="UTF-8" />\
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>\
  <title>Same Day Drain Service - Instant Dispatch Studio</title>\
  <style>\
    :root \{\
      --primary: #FF5500;\
      --primary-hover: #E04B00;\
      --dark-bg: #111418;\
      --card-bg: #1B2026;\
      --text-main: #FFFFFF;\
      --text-muted: #A0AAB5;\
      --accent-border: #2A323D;\
    \}\
\
    * \{ box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; \}\
    body \{ background-color: var(--dark-bg); color: var(--text-main); padding: 20px; min-height: 100vh; display: flex; justify-content: center; align-items: center; \}\
\
    .container \{ width: 100%; max-width: 600px; background: var(--card-bg); border-radius: 16px; border: 1px solid var(--accent-border); padding: 28px; box-shadow: 0 20px 40px rgba(0,0,0,0.5); \}\
    .header \{ text-align: center; margin-bottom: 24px; \}\
    .badge \{ display: inline-block; background: rgba(255, 85, 0, 0.15); color: var(--primary); padding: 6px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 10px; \}\
    .title \{ font-size: 1.8rem; font-weight: 800; \}\
    .subtitle \{ color: var(--text-muted); font-size: 0.95rem; margin-top: 6px; \}\
\
    .step-indicator \{ display: flex; justify-content: space-between; margin-bottom: 24px; position: relative; \}\
    .step-dot \{ width: 100%; height: 4px; background: var(--accent-border); margin: 0 4px; border-radius: 2px; transition: background 0.3s ease; \}\
    .step-dot.active \{ background: var(--primary); \}\
\
    .step \{ display: none; \}\
    .step.active \{ display: block; animation: fadeIn 0.3s ease-in-out; \}\
\
    @keyframes fadeIn \{ from \{ opacity: 0; transform: translateY(8px); \} to \{ opacity: 1; transform: translateY(0); \} \}\
\
    .step-title \{ font-size: 1.2rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; \}\
    \
    .grid \{ display: grid; grid-template-columns: 1fr 1fr; gap: 12px; \}\
    .option-btn \{ background: #222830; border: 2px solid var(--accent-border); color: var(--text-main); padding: 16px; border-radius: 12px; font-weight: 600; text-align: center; cursor: pointer; transition: all 0.2s ease; \}\
    .option-btn:hover, .option-btn.selected \{ border-color: var(--primary); background: rgba(255, 85, 0, 0.1); color: var(--text-main); \}\
\
    input, textarea, select \{ width: 100%; padding: 14px; background: #222830; border: 1px solid var(--accent-border); border-radius: 8px; color: #fff; font-size: 1rem; margin-bottom: 12px; outline: none; \}\
    input:focus, textarea:focus \{ border-color: var(--primary); \}\
\
    .nav-btns \{ display: flex; gap: 12px; margin-top: 24px; \}\
    .btn \{ flex: 1; padding: 14px; border-radius: 8px; font-weight: 700; border: none; cursor: pointer; transition: 0.2s ease; \}\
    .btn-prev \{ background: #2A323D; color: #fff; \}\
    .btn-next \{ background: var(--primary); color: #fff; \}\
    .btn-next:hover \{ background: var(--primary-hover); \}\
\
    .summary-card \{ background: #14181D; padding: 16px; border-radius: 8px; border: 1px solid var(--accent-border); margin-bottom: 16px; font-size: 0.95rem; line-height: 1.6; \}\
  </style>\
</head>\
<body>\
\
<div class="container">\
  <div class="header">\
    <span class="badge">\uc0\u9889  24/7 Rapid Response</span>\
    <h1 class="title">Request Same Day Service</h1>\
    <p class="subtitle">Tell us what's backing up and we'll dispatch a tech right away.</p>\
  </div>\
\
  <div class="step-indicator">\
    <div class="step-dot active" id="dot1"></div>\
    <div class="step-dot" id="dot2"></div>\
    <div class="step-dot" id="dot3"></div>\
    <div class="step-dot" id="dot4"></div>\
  </div>\
\
  <!-- STEP 1 -->\
  <div class="step active" id="step1">\
    <div class="step-title">01. What drain is giving you trouble?</div>\
    <div class="grid">\
      <div class="option-btn" onclick="selectOption(this, 'drain', 'Kitchen Sink / Garbage Disposal')">\uc0\u55358 \u56675  Kitchen Sink</div>\
      <div class="option-btn" onclick="selectOption(this, 'drain', 'Toilet / Bathroom Line')">\uc0\u55357 \u57021  Toilet / Bath</div>\
      <div class="option-btn" onclick="selectOption(this, 'drain', 'Main Sewer Line Backup')">\uc0\u55357 \u57000  Main Line Sewer</div>\
      <div class="option-btn" onclick="selectOption(this, 'drain', 'Commercial / Floor Drain')">\uc0\u55356 \u57314  Commercial Drain</div>\
    </div>\
  </div>\
\
  <!-- STEP 2 -->\
  <div class="step" id="step2">\
    <div class="step-title">02. How urgent is this?</div>\
    <div class="grid">\
      <div class="option-btn" onclick="selectOption(this, 'urgency', 'EMERGENCY - Active Overflow!')">\uc0\u55357 \u56613  Active Overflow (Need Emergency Dispatch)</div>\
      <div class="option-btn" onclick="selectOption(this, 'urgency', 'Same Day Window')">\uc0\u55357 \u56517  Today (Flexible Arrival Window)</div>\
    </div>\
  </div>\
\
  <!-- STEP 3 -->\
  <div class="step" id="step3">\
    <div class="step-title">03. Where should we send the technician?</div>\
    <input type="text" id="fullname" placeholder="Your Full Name" />\
    <input type="tel" id="phone" placeholder="Phone Number (for arrival text)" />\
    <input type="text" id="address" placeholder="Service Address / City" />\
    <textarea id="notes" rows="3" placeholder="Any extra details? (e.g., water rising, odd smells, slow flow)"></textarea>\
  </div>\
\
  <!-- STEP 4 -->\
  <div class="step" id="step4">\
    <div class="step-title">04. Review & Confirm Dispatch Request</div>\
    <div class="summary-card" id="summary"></div>\
    <p style="font-size: 0.8rem; color: var(--text-muted); text-align: center;">Submitting sends an urgent dispatch alert directly to our on-call plumbing technician.</p>\
  </div>\
\
  <div class="nav-btns">\
    <button class="btn btn-prev" id="prevBtn" onclick="changeStep(-1)" style="display:none;">Back</button>\
    <button class="btn btn-next" id="nextBtn" onclick="changeStep(1)">Continue \uc0\u8594 </button>\
  </div>\
</div>\
\
<script>\
  let currentStep = 1;\
  const formData = \{ drain: '', urgency: '', name: '', phone: '', address: '', notes: '' \};\
\
  function selectOption(el, key, val) \{\
    const parent = el.parentElement;\
    parent.querySelectorAll('.option-btn').forEach(btn => btn.classList.remove('selected'));\
    el.classList.add('selected');\
    formData[key] = val;\
  \}\
\
  function changeStep(delta) \{\
    if (delta === 1 && currentStep === 1 && !formData.drain) return alert('Please select a drain type.');\
    if (delta === 1 && currentStep === 2 && !formData.urgency) return alert('Please select urgency level.');\
    if (delta === 1 && currentStep === 3) \{\
      formData.name = document.getElementById('fullname').value;\
      formData.phone = document.getElementById('phone').value;\
      formData.address = document.getElementById('address').value;\
      formData.notes = document.getElementById('notes').value;\
      if (!formData.name || !formData.phone || !formData.address) return alert('Please fill in your name, phone, and address.');\
      \
      document.getElementById('summary').innerHTML = `\
        <strong>Issue:</strong> $\{formData.drain\}<br>\
        <strong>Urgency:</strong> $\{formData.urgency\}<br>\
        <strong>Customer:</strong> $\{formData.name\} ($\{formData.phone\})<br>\
        <strong>Location:</strong> $\{formData.address\}<br>\
        $\{formData.notes ? '<strong>Notes:</strong> ' + formData.notes : ''\}\
      `;\
    \}\
\
    if (currentStep === 4 && delta === 1) \{\
      alert('\uc0\u55356 \u57225  Dispatch Request Sent! Our technician will text/call you within 15 minutes.');\
      return;\
    \}\
\
    document.getElementById(`step$\{currentStep\}`).classList.remove('active');\
    document.getElementById(`dot$\{currentStep\}`).classList.remove('active');\
    \
    currentStep += delta;\
\
    document.getElementById(`step$\{currentStep\}`).classList.add('active');\
    document.getElementById(`dot$\{currentStep\}`).classList.add('active');\
\
    document.getElementById('prevBtn').style.display = currentStep === 1 ? 'none' : 'block';\
    document.getElementById('nextBtn').innerText = currentStep === 4 ? 'DISPATCH NOW \uc0\u55357 \u56960 ' : 'Continue \u8594 ';\
  \}\
</script>\
\
</body>\
</html>}